# Database Configuration
# Use 'turso' for Turso SQLite
DB_DRIVER=turso
# For Turso, use the database URL from your Turso project
# Example: file:./data.db for local SQLite, or a remote URL for Turso
DB_URL=file:./data.db

# Authentication
# Generate a strong, random secret key for JWT signing
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Application Settings
APP_NAME="Aplikasi Warung Enterprise"
APP_ENV=development # development, production
APP_PORT=3000

# Optional: Cloudinary Configuration for image uploads (if needed)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional: Email Configuration for notifications (if needed)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_email_password
# EMAIL_FROM="Aplikasi Warung Enterprise <noreply@example.com>"

# Optional: Barcode Scanner Integration (if using a specific API/service)
# BARCODE_API_KEY=your_barcode_api_key